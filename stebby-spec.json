 \"type\": \"integer\"\n             },\n             \"paymentsRequired\": {\n              \"description\": \"Number of payments that should be made by now according to schedule.\",\n              \"type\": \"integer\"\n             },\n             \"price\": {\n              \"description\": \"Price of a single payment.\",\n              \"type\": \"number\",\n              \"format\": \"float\"\n             },\n             \"start\": {\n              \"description\": \"When the contract starts.\",\n              \"type\": \"string\",\n              \"format\": \"date-time\"\n             },\n             \"status\": {\n              \"description\": \"Status of the contract.\",\n              \"type\": \"string\"\n             },\n             \"pointOfSale\": {\n              \"description\": \"Place where the purchase was made.\",\n              \"properties\": {\n               \"id\": {\n                \"description\": \"Identifier of the place.\",\n                \"type\": \"integer\"\n               },\n               \"name\": {\n                \"description\": \"Name of the point of sale.\",\n                \"type\": \"string\"\n               },\n               \"type\": {\n                \"description\": \"The type of the point of sale.\",\n                \"type\": \"string\",\n                \"example\": \"POS\"\n               }\n              },\n              \"type\": \"object\"\n             }\n            },\n            \"type\": \"object\"\n           }\n          },\n          \"pagination\": {\n           \"properties\": {\n            \"page\": {\n             \"type\": \"integer\",\n             \"example\": 1\n            },\n            \"pages\": {\n             \"type\": \"integer\",\n             \"example\": 3\n            },\n            \"size\": {\n             \"type\": \"integer\",\n             \"example\": 15\n            },\n            \"total\": {\n             \"type\": \"integer\",\n             \"example\": 2\n            }\n           },\n           \"type\": \"object\"\n          }\n         },\n         \"type\": \"object\"\n        },\n        \"example\": {\n         \"contracts\": [\n          {\n           \"client\": {\n            \"name\": \"John Doe\"\n           },\n           \"count\": 12,\n           \"end\": \"2022-12-31T22:00:00+00:00\",\n           \"externalReference\": \"549VJKDFJS49\",\n           \"id\": 1820,\n           \"interval\": 1,\n           \"name\": \"Insurance for everything\",\n           \"pointOfSale\": {\n            \"id\": 1555,\n            \"name\": \"Best Insurance\",\n            \"type\": \"POS\"\n           },\n           \"paymentsMade\": 3,\n           \"paymentsRequired\": 2,\n           \"price\": 13,\n           \"start\": \"2021-12-31T22:00:00+00:00\",\n           \"status\": \"PENDING\"\n          },\n          {\n           \"client\": {\n            \"name\": \"Jane Smith\"\n           },\n           \"count\": 6,\n           \"end\": \"2023-06-30T22:00:00+00:00\",\n           \"externalReference\": \"XYZ123ABC456\",\n           \"id\": 2001,\n           \"interval\": 3,\n           \"name\": \"Travel Accident Coverage\",\n           \"pointOfSale\": {\n            \"id\": 2000,\n            \"name\": \"Travel Safe\",\n            \"type\": \"POS\"\n           },\n           \"paymentsMade\": 1,\n           \"paymentsRequired\": 6,\n           \"price\": 99,\n           \"start\": \"2023-01-01T08:00:00+00:00\",\n           \"status\": \"ACTIVE\"\n          }\n         ],\n         \"pagination\": {\n          \"page\": 1,\n          \"pages\": 3,\n          \"size\": 15,\n          \"total\": 2\n         }\n        }\n       }\n      }\n     }\n    },\n    \"security\": [\n     {\n      \"ApiKeyAuth\": []\n     }\n    ]\n   }\n  },\n  \"/api/v4/purchase/revert/{purchaseLogId}\": {\n   \"post\": {\n    \"tags\": [\n     \"Purchases\"\n    ],\n    \"summary\": \"Revert a purchase\",\n    \"description\": \"Revert a purchase that has already been finalized.\",\n    \"operationId\": \"a79b4e89b987c5402898973f1e78c15b\",\n    \"parameters\": [\n     {\n      \"name\": \"purchaseLogId\",\n      \"in\": \"path\",\n      \"description\": \"Purchase log id to revert. It can be found in the purchase response as id.\",\n      \"required\": true,\n      \"schema\": {\n       \"type\": \"integer\"\n      }\n     }\n    ],\n    \"responses\": {\n     \"200\": {\n      \"description\": \"Successful revert returns an empty response.\",\n      \"content\": {\n       \"application/json\": {\n        \"schema\": {\n         \"type\": \"object\"\n        },\n        \"example\": []\n       }\n      }\n     }\n    },\n    \"security\": [\n     {\n      \"ApiKeyAuth\": []\n     }\n    ]\n   }\n  },\n  \"/api/v4/tickets\": {\n   \"post\": {\n    \"tags\": [\n     \"Tickets\"\n    ],\n    \"summary\": \"List usable tickets\",\n    \"description\": \"Retrieve non-expired, usable tickets. Only tickets with a future `validUntil` are returned. One of `client` or `ticketCode` must be provided.\",\n    \"operationId\": \"0d34835b87756ca08251cb244311edd2\",\n    \"requestBody\": {\n     \"required\": true,\n     \"content\": {\n      \"application/json\": {\n       \"schema\": {\n        \"properties\": {\n         \"client\": {\n          \"description\": \"Filter tickets by client. Required if `ticketCode` is not provided.\",\n          \"required\": [\n           \"context\",\n           \"value\"\n          ],\n          \"properties\": {\n           \"context\": {\n            \"description\": \"What the user is identified by (only verified phone numbers allowed, with country calling code). Required if `value` is provided.\",\n            \"type\": \"string\",\n            \"example\": \"EST_PIN\",\n            \"enum\": [\n             \"EST_PIN\",\n             \"LVA_PIN\",\n             \"LTU_PIN\",\n             \"PHONE\",\n             \"EMAIL\",\n             \"TOKEN\"\n            ]\n           },\n           \"value\": {\n            \"description\": \"Identifier value. Required if `context` is provided.\",\n            \"type\": \"string\",\n            \"example\": \"39014022745\"\n           }\n          },\n          \"type\": \"object\",\n          \"nullable\": true\n         },\n         \"purchasableCode\": {\n          \"description\": \"The `code` of the purchasable on the Stebby platform.\",\n          \"type\": \"string\",\n          \"example\": \"biz_543\",\n          \"nullable\": true\n         },\n         \"ticketCode\": {\n          \"description\": \"Directly search by ticket code. Required if `client` is not provided.\",\n          \"type\": \"string\",\n          \"example\": \"VVKAHDKLASKJA\",\n          \"nullable\": true\n         },\n         \"pagination\": {\n          \"description\": \"Pagination settings\",\n          \"properties\": {\n           \"limit\": {\n            \"type\": \"integer\",\n            \"example\": 15\n           },\n           \"page\": {\n            \"type\": \"integer\",\n            \"example\": 1\n           }\n          },\n          \"type\": \"object\",\n          \"nullable\": true\n         }\n        },\n        \"type\": \"object\"\n       },\n       \"example\": {\n        \"client\": {\n         \"context\": \"EST_PIN\",\n         \"value\": \"39014022745\"\n        },\n        \"pagination\": {\n         \"limit\": 15,\n         \"page\": 1\n        },\n        \"purchasableCode\": \"biz_543\",\n        \"ticketCode\": \"VVKAHDKLASKJA\"\n       }\n      }\n     }\n    },\n    \"responses\": {\n     \"200\": {\n      \"description\": \"Successful response returns pagination info and array of tickets.\",\n      \"content\": {\n       \"application/json\": {\n        \"schema\": {\n         \"properties\": {\n          \"pagination\": {\n           \"properties\": {\n            \"page\": {\n             \"type\": \"integer\",\n             \"example\": 1\n            },\n            \"pages\": {\n             \"type\": \"integer\",\n             \"example\": 1\n            },\n            \"size\": {\n             \"type\": \"integer\",\n             \"example\": 15\n            },\n            \"total\": {\n             \"type\": \"integer\",\n             \"example\": 2\n            }\n           },\n           \"type\": \"object\"\n          },\n          \"tickets\": {\n           \"type\": \"array\",\n           \"items\": {\n            \"properties\": {\n             \"client\": {\n              \"description\": \"Information about the ticket holder.\",\n              \"properties\": {\n               \"name\": {\n                \"type\": \"string\",\n                \"example\": \"John Doe\"\n               }\n              },\n              \"type\": \"object\"\n             },\n             \"code\": {\n              \"description\": \"Ticket code.\",\n              \"type\": \"string\",\n              \"example\": \"VVKAHDKLASKJA898\"\n             },\n             \"validUntil\": {\n              \"description\": \"Ticket expiration date. Always a future timestamp - expired tickets are not returned.\",\n              \"type\": \"string\",\n              \"format\": \"date-time\",\n              \"example\": \"2026-09-18T20:00:00+00:00\"\n             },\n             \"purchasable\": {\n              \"description\": \"Purchasable related to the ticket.\",\n              \"properties\": {\n               \"amount\": {\n                \"description\": \"Always 1. A ticket represents a single purchased unit.\",\n                \"type\": \"integer\",\n                \"example\": 1\n               },\n               \"category\": {\n                \"description\": \"Purchasable category.\",\n                \"type\": \"string\",\n                \"example\": \"SPORTS\"\n               },\n               \"code\": {\n                \"description\": \"Purchasable code.\",\n                \"type\": \"string\",\n                \"example\": \"biz_54344\"\n               },\n               \"exists\": {\n                \"description\": \"Always true for tickets. A ticket can only exist for a purchasable that is registered in Stebby.\",\n                \"type\": \"boolean\",\n                \"example\": true\n               },\n               \"name\": {\n                \"description\": \"Name of the service.\",\n                \"type\": \"string\",\n                \"example\": \"Running\"\n               },\n               \"price\": {\n                \"description\": \"Price of the service.\",\n                \"type\": \"number\",\n                \"format\": \"float\",\n                \"example\": 4.5\n               }\n              },\n              \"type\": \"object\"\n             }\n            },\n            \"type\": \"object\"\n           }\n          }\n         },\n         \"type\": \"object\"\n        },\n        \"example\": {\n         \"pagination\": {\n          \"page\": 1,\n          \"pages\": 1,\n          \"size\": 15,\n          \"total\": 2\n         },\n         \"tickets\": [\n          {\n           \"client\": {\n            \"name\": \"John Doe\"\n           },\n           \"code\": \"VVKAHDKLASKJA898\",\n           \"validUntil\": \"2026-09-18T20:00:00+00:00\",\n           \"purchasable\": {\n            \"amount\": 1,\n            \"category\": \"SPORTS\",\n            \"code\": \"biz_54344\",\n            \"exists\": true,\n            \"name\": \"Running\",\n            \"price\": 4.5\n           }\n          },\n          {\n           \"client\": {\n            \"name\": \"John Doe\"\n           },\n           \"code\": \"VVKAHDKLASKJA899\",\n           \"validUntil\": \"2026-09-18T20:00:00+00:00\",\n           \"purchasable\": {\n            \"amount\": 1,\n            \"category\": \"SPORTS\",\n            \"code\": \"biz_54345\",\n            \"exists\": true,\n            \"name\": \"Running\",\n            \"price\": 4.5\n           }\n          }\n         ]\n        }\n       }\n      }\n     }\n    },\n    \"security\": [\n     {\n      \"ApiKeyAuth\": []\n     }\n    ]\n   }\n  },\n  \"/api/v4/tickets/use/{ticketCode}\": {\n   \"post\": {\n    \"tags\": [\n     \"Tickets\"\n    ],\n    \"summary\": \"Use a ticket\",\n    \"description\": \"Mark a ticket as used.\",\n    \"operationId\": \"8aa397b52317895d06c5742d3a385e37\",\n    \"parameters\": [\n     {\n      \"name\": \"ticketCode\",\n      \"in\": \"path\",\n      \"description\": \"Ticket code to mark as used.\",\n      \"required\": true,\n      \"schema\": {\n       \"type\": \"string\"\n      },\n      \"example\": \"VVKAHDKLASKJA898\"\n     }\n    ],\n    \"responses\": {\n     \"200\": {\n      \"description\": \"Successful response confirms the ticket was marked as used.\",\n      \"content\": {\n       \"application/json\": {\n        \"schema\": {\n         \"type\": \"object\"\n        },\n        \"example\": []\n       }\n      }\n     }\n    },\n    \"security\": [\n     {\n      \"ApiKeyAuth\": []\n     }\n    ]\n   }\n  }\n },\n \"schemas\": {}\n}"