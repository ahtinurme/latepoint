"{\n \"paths\": {\n  \"/api/v4/identify/token/{reference}\": {\n   \"post\": {\n    \"tags\": [\n     \"Identification\"\n    ],\n    \"summary\": \"Get token status by reference\",\n    \"description\": \"Use this request to determine whether user has a usable token.\",\n    \"operationId\": \"9cb550fbd804e54844c09fcd14f524f6\",\n    \"parameters\": [\n     {\n      \"name\": \"reference\",\n      \"in\": \"path\",\n      \"description\": \"Reference received from the request-token endpoint.\",\n      \"required\": true,\n      \"schema\": {\n       \"type\": \"string\"\n      },\n      \"example\": \"7e41abca-c7d3-4b10-8fde-68dab2e3dd42\"\n     }\n    ],\n    \"responses\": {\n     \"200\": {\n      \"description\": \"Successful response returns the token and its expiry.\",\n      \"content\": {\n       \"application/json\": {\n        \"schema\": {\n         \"properties\": {\n          \"token\": {\n           \"description\": \"Token value to use as client.value with context TOKEN in calculate and purchase requests.\",\n           \"type\": \"string\"\n          },\n          \"expires_at\": {\n           \"description\": \"Token expiry timestamp. For recurring tokens, extended on every calculate call.\",\n           \"type\": \"string\"\n          }\n         },\n         \"type\": \"object\"\n        },\n        \"example\": {\n         \"token\": \"7e41abca-c7d3-4b10-8fde-68dab2e3dd42\",\n         \"expires_at\": \"2025-09-18T20:00:00+00:00\"\n        }\n       }\n      }\n     }\n    },\n    \"security\": [\n     {\n      \"ApiKeyAuth\": []\n     }\n    ]\n   }\n  },\n  \"/api/v4/identify/invalidate-token\": {\n   \"post\": {\n    \"tags\": [\n     \"Identification\"\n    ],\n    \"summary\": \"Invalidate user token\",\n    \"description\": \"Mostly relevant for recurring tokens, non-recurring have short expiry. User can also trigger it in Stebby self-service.\",\n    \"operationId\": \"668166b4196abc75a8ddb35e0a1739f9\",\n    \"requestBody\": {\n     \"required\": true,\n     \"content\": {\n      \"application/json\": {\n       \"schema\": {\n        \"properties\": {\n         \"token\": {\n          \"description\": \"Token value, required if reference not provided.\",\n          \"type\": \"string\",\n          \"nullable\": false\n         },\n         \"reference\": {\n          \"description\": \"Reference value, required if token not provided.\",\n          \"type\": \"string\",\n          \"nullable\": false\n         }\n        },\n        \"type\": \"object\"\n       },\n       \"example\": {\n        \"reference\": \"7e41abca-c7d3-4b10-8fde-68dab2e3dd42\"\n       }\n      }\n     }\n    },\n    \"responses\": {\n     \"200\": {\n      \"description\": \"Successful request expires the token.\",\n      \"content\": {\n       \"application/json\": {\n        \"schema\": {\n         \"properties\": {\n          \"success\": {\n           \"type\": \"boolean\"\n          }\n         },\n         \"type\": \"object\"\n        },\n        \"example\": {\n         \"success\": true\n        }\n       }\n      }\n     }\n    },\n    \"security\": [\n     {\n      \"ApiKeyAuth\": []\n     }\n    ]\n   }\n  },\n  \"/api/v4/identify/request-token\": {\n   \"post\": {\n    \"tags\": [\n     \"Identification\"\n    ],\n    \"summary\": \"Initialize a new token request for a user\",\n    \"description\": \"Creates an unassigned token request. Returns a reference for polling and a URL to redirect the client to for authorization.\",\n    \"operationId\": \"cc4745ee78d90884b59b5782da8e285a\",\n    \"requestBody\": {\n     \"required\": true,\n     \"content\": {\n      \"application/json\": {\n       \"schema\": {\n        \"required\": [\n         \"successRedirect\",\n         \"cancelRedirect\"\n        ],\n        \"properties\": {\n         \"cancelRedirect\": {\n          \"description\": \"Functional URL, where user must be sent in case they do not authorize the token creation.\",\n          \"type\": \"string\",\n          \"nullable\": false\n         },\n         \"recurring\": {\n          \"description\": \"Set to true to issue a long-lived reusable token, e.g. for recurring monthly payments.\",\n          \"type\": \"boolean\",\n          \"nullable\": false\n         },\n         \"successRedirect\": {\n          \"description\": \"Functional URL, where user is sent after token is authorized.\",\n          \"type\": \"string\",\n          \"nullable\": false\n         }\n        },\n        \"type\": \"object\"\n       },\n       \"example\": {\n        \"cancelRedirect\": \"https://app.stebby.eu/login?cancel\",\n        \"successRedirect\": \"https://app.stebby.eu/login?success\"\n       }\n      }\n     }\n    },\n    \"responses\": {\n     \"200\": {\n      \"description\": \"Successful response returns a polling reference and a URL to redirect the client to for token authorization.\",\n      \"content\": {\n       \"application/json\": {\n        \"schema\": {\n         \"properties\": {\n          \"reference\": {\n           \"description\": \"Reference, that can be used for token status checks.\",\n           \"type\": \"string\"\n          },\n          \"redirectUrl\": {\n           \"description\": \"Site where user will either confirm or deny the issue of token.\",\n           \"type\": \"string\"\n          }\n         },\n         \"type\": \"object\"\n        },\n        \"example\": {\n         \"reference\": \"7e41abca-c7d3-4b10-8fde-68dab2e3dd42\",\n         \"redirectUrl\": \"https://app.stebby.eu/login?issueToken\"\n        }\n       }\n      }\n     }\n    },\n    \"security\": [\n     {\n      \"ApiKeyAuth\": []\n     }\n    ]\n   }\n  },\n  \"/api/v4/purchase/calculate\": {\n   \"post\": {\n    \"tags\": [\n     \"Purchases\"\n    ],\n    \"summary\": \"Calculate\",\n    \"description\": \"Calculates how much the client can pay with their Stebby account for a given set of purchasables.\\n\\nEach purchasable in the response includes an `exists` field:\\n- `exists: true` - the reference code was matched to a service in Stebby. The item will be registered in Stebby on purchase and the client's Stebby balance may be used.\\n- `exists: false` - no matching service was found. The full price is added to `totalDifference` and the item **will not be recorded in Stebby** when purchase is called. The amount must be collected fully outside Stebby.\\n\\n`totalAvailable` reflects only the Stebby-eligible portion (matched items). `totalDifference` is what the client must pay by other means - this includes both unmatched item prices and any shortfall on matched items.\\n\\n**Before calling purchase, always show the client `totalAvailable` and ask for confirmation.** These funds will be deducted from their Stebby account. The client must explicitly agree before you proceed.\\n\\n**Recommended payment flow when `totalDifference > 0`:**\\n1. Call purchase - this deducts `totalAvailable` from the client's Stebby balance immediately.\\n2. Collect `totalDifference` via another payment method (e.g. credit card, banklink).\\n3. If the follow-up payment fails or is abandoned, **revert the Stebby purchase promptly**. Do not leave a partially paid order unresolved - revert it as soon as it is clear the client will not complete payment.\",\n    \"operationId\": \"df9549445293a64b05d989386cbd7847\",\n    \"requestBody\": {\n     \"required\": true,\n     \"content\": {\n      \"application/json\": {\n       \"schema\": {\n        \"required\": [\n         \"client\",\n         \"purchasables\"\n        ],\n        \"properties\": {\n         \"client\": {\n          \"description\": \"The user who is paying.\",\n          \"required\": [\n           \"context\",\n           \"value\"\n          ],\n          \"properties\": {\n           \"context\": {\n            \"description\": \"What the user is being identified by.\\n\\nAPI keys are restricted to `TOKEN` by default - contact us to enable `EST_PIN`, `LVA_PIN`, `LTU_PIN`, `PHONE`, or `EMAIL` contexts.\\n\\nFor `PHONE` context, only verified numbers are accepted and the country calling code must be included (e.g. +372).\",\n            \"type\": \"string\",\n            \"example\": \"TOKEN\",\n            \"enum\": [\n             \"EST_PIN\",\n             \"LVA_PIN\",\n             \"LTU_PIN\",\n             \"PHONE\",\n             \"EMAIL\",\n             \"TOKEN\"\n            ]\n           },\n           \"value\": {\n            \"description\": \"The value of the identifier.\",\n            \"type\": \"string\",\n            \"example\": \"7e41abca-c7d3-4b10-8fde-68dab2e3dd42\"\n           }\n          },\n          \"type\": \"object\"\n         },\n         \"purchasables\": {\n          \"description\": \"Array of purchasables being bought.\",\n          \"required\": [\n           \"code\"\n          ],\n          \"type\": \"array\",\n          \"items\": {\n           \"properties\": {\n            \"code\": {\n             \"description\": \"The purchasable code on the Stebby platform.\",\n             \"type\": \"string\",\n             \"example\": \"biz_12345\"\n            },\n            \"price\": {\n             \"description\": \"If provided, will override the price on the Stebby platform.\",\n             \"type\": \"number\",\n             \"format\": \"float\",\n             \"example\": 5,\n             \"nullable\": true\n            },\n            \"name\": {\n             \"description\": \"Override purchasable name. Defaults to service name.\",\n             \"type\": \"string\",\n             \"example\": \"custom service name!\",\n             \"nullable\": true\n            },\n            \"applyDiscount\": {\n             \"description\": \"If Stebby discounts should be applied or not. Defaults to true.\",\n             \"type\": \"boolean\",\n             \"example\": true,\n             \"nullable\": true\n            },\n            \"amount\": {\n             \"description\": \"How many units of the selected purchasable is being sold. Defaults to 1.\",\n             \"type\": \"integer\",\n             \"example\": 1,\n             \"nullable\": true\n            }\n           },\n           \"type\": \"object\"\n          }\n         }\n        },\n        \"type\": \"object\"\n       },\n       \"example\": {\n        \"client\": {\n         \"context\": \"TOKEN\",\n         \"value\": \"7e41abca-c7d3-4b10-8fde-68dab2e3dd42\"\n        },\n        \"purchasables\": [\n         {\n          \"code\": \"biz_34567\",\n          \"price\": 5,\n          \"name\": \"custom service name!\",\n          \"applyDiscount\": true,\n          \"amount\": 1\n         },\n         {\n          \"code\": \"biz_23456\",\n          \"price\": 10,\n          \"amount\": 2\n         },\n         {\n          \"code\": \"biz_12345\",\n          \"price\": 3.5\n         }\n        ]\n       }\n      }\n     }\n    },\n    \"responses\": {\n     \"200\": {\n      \"description\": \"Successful calculation returns an array of purchasables with their prices and processed amounts.\",\n      \"content\": {\n       \"application/json\": {\n        \"schema\": {\n         \"properties\": {\n          \"purchaseReferenceId\": {\n           \"description\": \"ID returned from calculate, required to execute the purchase. Must be used promptly - the reference expires if not consumed shortly after calculation.\",\n           \"type\": \"integer\"\n          },\n          \"client\": {\n           \"description\": \"Client information. Only returned for certain identification contexts.\",\n           \"properties\": {\n            \"name\": {\n             \"description\": \"Full name of the client. Only present when `context` is `EST_PIN`.\",\n             \"type\": \"string\",\n             \"example\": \"Mari Maasikas\",\n             \"nullable\": true\n            }\n           },\n           \"type\": \"object\",\n           \"nullable\": true\n          },\n          \"purchasables\": {\n           \"description\": \"Calculated result for each submitted purchasable.\",\n           \"type\": \"array\",\n           \"items\": {\n            \"properties\": {\n             \"amount\": {\n              \"description\": \"Number of items.\",\n              \"type\": \"integer\"\n             },\n             \"category\": {\n              \"description\": \"Purchasable category.\",\n              \"type\": \"string\",\n              \"example\": \"SPORTS\"\n             },\n             \"code\": {\n              \"description\": \"Purchasable code.\",\n              \"type\": \"string\"\n             },\n             \"exists\": {\n              \"description\": \"Indicates if this service exists on the Stebby platform.\",\n              \"type\": \"boolean\"\n             },\n             \"name\": {\n              \"description\": \"Name of the service.\",\n              \"type\": \"string\"\n             },\n             \"price\": {\n              \"description\": \"Price of the service.\",\n              \"type\": \"number\",\n              \"format\": \"float\"\n             }\n            },\n            \"type\": \"object\"\n           }\n          },\n          \"total\": {\n           \"description\": \"The total sum of all purchasables.\",\n           \"type\": \"number\",\n           \"format\": \"float\"\n          },\n          \"totalAvailable\": {\n           \"description\": \"The amount of money available on the Stebby platform for this purchase.\\n\\nYou can still proceed with the purchase even when `totalAvailable` is 0:\\n- **No matching reference code:** The purchase will not be recorded in Stebby at all.\\n- **Matching reference code found:** The purchase is registered in Stebby as 0€ from the user's Stebby balance - all funds are collected at the shop/counter.\\n\\n**Note:** Due to various reasons (e.g., limits, restrictions, or technical issues), funds might not always be accessible from the client's Stebby account.\",\n           \"type\": \"number\",\n           \"format\": \"float\"\n          },\n          \"totalDifference\": {\n           \"description\": \"The amount exceeding what is available on the Stebby platform.\\n\\nThis is the amount the client must cover themselves, either on-site or via another payment method.\",\n           \"type\": \"number\",\n           \"format\": \"float\"\n          }\n         },\n         \"type\": \"object\"\n        },\n        \"example\": {\n         \"purchaseReferenceId\": 115,\n         \"purchasables\": [\n          {\n           \"amount\": 1,\n           \"category\": \"SPORTS\",\n           \"code\": \"biz_12345\",\n           \"exists\": true,\n           \"name\": \"custom service name!\",\n           \"price\": 3.5\n          },\n          {\n           \"amount\": 2,\n           \"category\": \"SPORTS\",\n           \"code\": \"biz_99999\",\n           \"exists\": false,\n           \"name\": \"running\",\n           \"price\": 4.5\n          }\n         ],\n         \"total\": 12.5,\n         \"totalAvailable\": 10,\n         \"totalDifference\": 2.5,\n         \"client\": {\n          \"name\": \"Mari Maasikas\"\n         }\n        }\n       }\n      }\n     }\n    },\n    \"security\": [\n     {\n      \"ApiKeyAuth\": []\n     }\n    ]\n   }\n  },\n  \"/api/v4/purchase/{purchaseReferenceId}\": {\n   \"post\": {\n    \"tags\": [\n     \"Purchases\"\n    ],\n    \"summary\": \"Make a purchase\",\n    \"description\": \"Execute a purchase for the client using the `purchaseReferenceId` from calculate.\\n\\nCalling this endpoint immediately deducts `totalAvailable` from the client's Stebby balance. If the order also has a `totalDifference`, collect that via another payment method (e.g. credit card, banklink) after this call. If the follow-up payment cannot be completed, revert each purchase using the `id` values returned here.\",\n    \"operationId\": \"3c631a6a68caea7cfec93c56094c656b\",\n    \"parameters\": [\n     {\n      \"name\": \"purchaseReferenceId\",\n      \"in\": \"path\",\n      \"description\": \"Purchase reference id received in the calculate request.\",\n      \"required\": true,\n      \"schema\": {\n       \"type\": \"integer\"\n      },\n      \"example\": 115\n     }\n    ],\n    \"responses\": {\n     \"200\": {\n      \"description\": \"Successful purchase returns an array with information about purchased items.\",\n      \"content\": {\n       \"application/json\": {\n        \"schema\": {\n         \"properties\": {\n          \"purchases\": {\n           \"description\": \"Array with information about purchased items.\",\n           \"type\": \"array\",\n           \"items\": {\n            \"properties\": {\n             \"client\": {\n              \"description\": \"Information about the payer of the purchase.\",\n              \"properties\": {\n               \"name\": {\n                \"description\": \"Name of the client. Null if the client has no profile name.\",\n                \"type\": \"string\",\n                \"example\": \"Jane Doe\",\n                \"nullable\": true\n               }\n              },\n              \"type\": \"object\"\n             },\n             \"code\": {\n              \"description\": \"Reference code of the purchased service.\",\n              \"type\": \"string\",\n              \"example\": \"biz_23456\",\n              \"nullable\": false\n             },\n             \"description\": {\n              \"description\": \"Name of the purchased service.\",\n              \"type\": \"string\",\n              \"example\": \"Monthly pass\"\n             },\n             \"id\": {\n              \"description\": \"Purchase ID on the Stebby platform. Use this as purchaseLogId when reverting.\",\n              \"type\": \"integer\",\n              \"example\": 153\n             },\n             \"price\": {\n              \"description\": \"Total price of the purchase, formatted to 2 decimal places.\",\n              \"type\": \"number\",\n              \"format\": \"float\",\n              \"example\": 13.5\n             },\n             \"processed\": {\n              \"description\": \"Amount paid through Stebby balance, formatted to 2 decimal places. 0.00 if no Stebby funds were used.\",\n              \"type\": \"number\",\n              \"format\": \"float\",\n              \"example\": 5.5\n             },\n             \"purchasedAt\": {\n              \"description\": \"ISO 8601 timestamp of when the purchase was made.\",\n              \"type\": \"string\",\n              \"format\": \"date-time\",\n              \"example\": \"2025-03-18T14:00:00+00:00\"\n             },\n             \"pointOfSale\": {\n              \"description\": \"Point of sale where the purchase was made.\",\n              \"properties\": {\n               \"id\": {\n                \"description\": \"Point of sale ID.\",\n                \"type\": \"integer\",\n                \"example\": 1555\n               },\n               \"name\": {\n                \"description\": \"Name of the point of sale.\",\n                \"type\": \"string\",\n                \"example\": \"Main Gym\"\n               },\n               \"type\": {\n                \"description\": \"Type of the point of sale.\",\n                \"type\": \"string\",\n                \"example\": \"POS\"\n               }\n              },\n              \"type\": \"object\"\n             }\n            },\n            \"type\": \"object\"\n           }\n          }\n         },\n         \"type\": \"object\"\n        },\n        \"example\": {\n         \"purchases\": [\n          {\n           \"client\": {\n            \"name\": \"Jane Doe\"\n           },\n           \"code\": \"biz_23456\",\n           \"description\": \"Monthly pass\",\n           \"id\": 153,\n           \"price\": 13.5,\n           \"processed\": 5.5,\n           \"purchasedAt\": \"2025-03-18T14:00:00+00:00\",\n           \"pointOfSale\": {\n            \"id\": 1555,\n            \"name\": \"Main Gym\",\n            \"type\": \"POS\"\n           }\n          },\n          {\n           \"client\": {\n            \"name\": \"Jane Doe\"\n           },\n           \"code\": \"biz_12345\",\n           \"description\": \"Running session\",\n           \"id\": 154,\n           \"price\": 17,\n           \"processed\": 0,\n           \"purchasedAt\": \"2025-03-18T14:00:00+00:00\",\n           \"pointOfSale\": {\n            \"id\": 1555,\n            \"name\": \"Main Gym\",\n            \"type\": \"POS\"\n           }\n          }\n         ]\n        }\n       }\n      }\n     }\n    },\n    \"security\": [\n     {\n      \"ApiKeyAuth\": []\n     }\n    ]\n   }\n  },\n  \"/api/v4/purchase/purchases\": {\n   \"post\": {\n    \"tags\": [\n     \"Purchases\"\n    ],\n    \"summary\": \"Purchases list\",\n    \"description\": \"List purchases for the service provider. Default ordering: purchase time descending.\",\n    \"operationId\": \"1eb2e7cd855ce562e1de43cd07d02657\",\n    \"requestBody\": {\n     \"content\": {\n      \"application/json\": {\n       \"schema\": {\n        \"properties\": {\n         \"pagination\": {\n          \"description\": \"Pagination settings.\",\n          \"properties\": {\n           \"limit\": {\n            \"description\": \"Total items per page.\",\n            \"type\": \"integer\",\n            \"example\": 15,\n            \"nullable\": true\n           },\n           \"page\": {\n            \"description\": \"Current page.\",\n            \"type\": \"integer\",\n            \"example\": 1,\n            \"nullable\": true\n           }\n          },\n          \"type\": \"object\",\n          \"nullable\": true\n         },\n         \"client\": {\n          \"description\": \"Filter purchases by client.\",\n          \"required\": [\n           \"context\",\n           \"value\"\n          ],\n          \"properties\": {\n           \"context\": {\n            \"description\": \"Context of the identifier value. Only verified phone numbers allowed; include country calling code (+372). Required if value is provided.\",\n            \"type\": \"string\",\n            \"example\": \"EMAIL\",\n            \"nullable\": true,\n            \"enum\": [\n             \"EST_PIN\",\n             \"LVA_PIN\",\n             \"LTU_PIN\",\n             \"PHONE\",\n             \"EMAIL\",\n             \"TOKEN\"\n            ]\n           },\n           \"value\": {\n            \"description\": \"Identifier value. Required if context is provided.\",\n            \"type\": \"string\",\n            \"example\": \"jane.doe@stebby.eu\",\n            \"nullable\": true\n           }\n          },\n          \"type\": \"object\",\n          \"nullable\": true\n         }\n        },\n        \"type\": \"object\"\n       },\n       \"example\": {\n        \"pagination\": {\n         \"limit\": 15,\n         \"page\": 1\n        },\n        \"client\": {\n         \"context\": \"EMAIL\",\n         \"value\": \"jane.doe@stebby.eu\"\n        }\n       }\n      }\n     }\n    },\n    \"responses\": {\n     \"200\": {\n      \"description\": \"Successful response returns an array of purchases and pagination details.\",\n      \"content\": {\n       \"application/json\": {\n        \"schema\": {\n         \"properties\": {\n          \"pagination\": {\n           \"properties\": {\n            \"page\": {\n             \"type\": \"integer\",\n             \"example\": 1\n            },\n            \"pages\": {\n             \"type\": \"integer\",\n             \"example\": 3\n            },\n            \"size\": {\n             \"type\": \"integer\",\n             \"example\": 15\n            },\n            \"total\": {\n             \"type\": \"integer\",\n             \"example\": 2\n            }\n           },\n           \"type\": \"object\"\n          },\n          \"purchases\": {\n           \"description\": \"Array with information about purchased items.\",\n           \"type\": \"array\",\n           \"items\": {\n            \"properties\": {\n             \"client\": {\n              \"description\": \"Information about the payer of the purchase.\",\n              \"properties\": {\n               \"name\": {\n                \"description\": \"Name of the client.\",\n                \"type\": \"string\",\n                \"example\": \"Jane Doe\"\n               }\n              },\n              \"type\": \"object\"\n             },\n             \"code\": {\n              \"description\": \"Purchasable code.\",\n              \"type\": \"string\"\n             },\n             \"description\": {\n              \"description\": \"Description of the purchase.\",\n              \"type\": \"string\"\n             },\n             \"id\": {\n              \"description\": \"Reference to the purchase object on the Stebby platform.\",\n              \"type\": \"integer\"\n             },\n             \"price\": {\n              \"description\": \"Price of the purchase.\",\n              \"type\": \"number\",\n              \"format\": \"float\"\n             },\n             \"processed\": {\n              \"description\": \"The amount of money used through Stebby.\",\n              \"type\": \"number\",\n              \"format\": \"float\"\n             },\n             \"purchasedAt\": {\n              \"description\": \"When the purchase was made.\",\n              \"type\": \"string\",\n              \"format\": \"date-time\"\n             },\n             \"pointOfSale\": {\n              \"description\": \"Place where the purchase was made.\",\n              \"properties\": {\n               \"id\": {\n                \"description\": \"Identifier of the place.\",\n                \"type\": \"integer\"\n               },\n               \"name\": {\n                \"description\": \"Name of the point of sale.\",\n                \"type\": \"string\",\n                \"example\": \"Estonian Point Of Sale\"\n               },\n               \"type\": {\n                \"description\": \"The type of the point of sale.\",\n                \"type\": \"string\",\n                \"example\": \"POS\"\n               }\n              },\n              \"type\": \"object\"\n             }\n            },\n            \"type\": \"object\"\n           }\n          }\n         },\n         \"type\": \"object\"\n        },\n        \"example\": {\n         \"pagination\": {\n          \"page\": 1,\n          \"pages\": 3,\n          \"size\": 15,\n          \"total\": 2\n         },\n         \"purchases\": [\n          {\n           \"client\": {\n            \"name\": \"Jane Doe\"\n           },\n           \"code\": \"biz_23456\",\n           \"description\": \"The best thing you could buy\",\n           \"id\": 153,\n           \"pointOfSale\": {\n            \"id\": 1555,\n            \"name\": \"Shoes for Sport\",\n            \"type\": \"POS\"\n           },\n           \"price\": 13,\n           \"processed\": 5.5,\n           \"purchasedAt\": \"2022-02-16T22:00:00+00:00\"\n          },\n          {\n           \"client\": {\n            \"name\": \"Jane Doe\"\n           },\n           \"code\": \"biz_23456\",\n           \"description\": \"The best thing you could buy\",\n           \"id\": 154,\n           \"pointOfSale\": {\n            \"id\": 1555,\n            \"name\": \"Shoes for Sport\",\n            \"type\": \"POS\"\n           },\n           \"price\": 13,\n           \"processed\": 5.5,\n           \"purchasedAt\": \"2022-02-23T22:00:00+00:00\"\n          }\n         ]\n        }\n       }\n      }\n     }\n    },\n    \"security\": [\n     {\n      \"ApiKeyAuth\": []\n     }\n    ]\n   }\n  },\n  \"/api/v4/purchase/contracts\": {\n   \"post\": {\n    \"tags\": [\n     \"Purchases\"\n    ],\n    \"summary\": \"Purchase contracts\",\n    \"description\": \"List of purchase contracts for the service provider.\",\n    \"operationId\": \"1464c6b38a42ae0a69cef1396af64d70\",\n    \"requestBody\": {\n     \"required\": true,\n     \"content\": {\n      \"application/json\": {\n       \"schema\": {\n        \"properties\": {\n         \"pagination\": {\n          \"description\": \"Pagination settings.\",\n          \"properties\": {\n           \"limit\": {\n            \"description\": \"Total items per page.\",\n            \"type\": \"integer\",\n            \"example\": 15,\n            \"nullable\": true\n           },\n           \"page\": {\n            \"description\": \"Current page.\",\n            \"type\": \"integer\",\n            \"example\": 1,\n            \"nullable\": true\n           }\n          },\n          \"type\": \"object\",\n          \"nullable\": true\n         },\n         \"client\": {\n          \"description\": \"Filter contracts by client.\",\n          \"required\": [\n           \"context\",\n           \"value\"\n          ],\n          \"properties\": {\n           \"context\": {\n            \"description\": \"Context of the identifier value. Only verified phone numbers allowed; include country calling code (+372). Required if value is provided.\",\n            \"type\": \"string\",\n            \"example\": \"EST_PIN\",\n            \"nullable\": true,\n            \"enum\": [\n             \"EST_PIN\",\n             \"LVA_PIN\",\n             \"LTU_PIN\",\n             \"PHONE\",\n             \"EMAIL\",\n             \"TOKEN\"\n            ]\n           },\n           \"value\": {\n            \"description\": \"Identifier value. Required if context is provided.\",\n            \"type\": \"string\",\n            \"example\": \"39014022745\",\n            \"nullable\": true\n           }\n          },\n          \"type\": \"object\",\n          \"nullable\": true\n         }\n        },\n        \"type\": \"object\"\n       },\n       \"example\": {\n        \"pagination\": {\n         \"limit\": 15,\n         \"page\": 1\n        },\n        \"client\": {\n         \"context\": \"EST_PIN\",\n   